DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3

# Used for all outbound RAG Core calls; each tenant stores its own encrypted Core API key.
RAG_CORE_BASE_URL=http://127.0.0.1:8000
RAG_CONNECT_TIMEOUT_SECONDS=5
RAG_READ_TIMEOUT_SECONDS=30

# OpenAI-compatible Chat Completions API
# For OpenRouter, set this to https://openrouter.ai/api/v1.
AI_PROVIDER_API_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_TIMEOUT_SECONDS=60

PUBLIC_EXECUTION_RATE=10/minute
MAX_INPUT_CHARS=20000
MAX_HISTORY_MESSAGES=20
MAX_HISTORY_CHARS=40000
MAX_RAG_CONTEXT_CHARS=24000
MAX_OUTPUT_TOKENS=4096


